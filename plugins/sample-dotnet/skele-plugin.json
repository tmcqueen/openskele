{
  "$schema": "../../protocol/plugin-manifest.schema.json",
  "id": "sample.dotnet",
  "name": "Runtime Info",
  "version": "0.1.0",
  "protocol": "0.1",
  "main": { "command": "dotnet", "args": ["bin/Release/net10.0/SampleDotnet.dll"] },
  "activationEvents": [],
  "contributes": {
    "commands": [{ "id": "dotnet.describe", "title": "Describe Runtime", "category": ".NET" }],
    "menus": {
      "menubar/Tools": [{ "command": "dotnet.describe", "group": "2_dotnet", "order": 1 }]
    },
    "viewContainers": [
      { "id": "dotnet.container", "title": "Runtime", "icon": "server-environment", "bar": "secondary" }
    ],
    "views": [{ "id": "dotnet.runtime", "title": "Runtime", "kind": "tree", "container": "dotnet.container" }],
    "configuration": {
      "title": "Runtime Info",
      "properties": {
        "dotnet.label": {
          "type": "string",
          "default": "Running on",
          "minLength": 1,
          "description": "Text that precedes the runtime description."
        }
      }
    }
  }
}
