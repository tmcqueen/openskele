{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentContribution": {
      "description": "An agent the workbench can talk to: any executable speaking the Agent Client\nProtocol over stdio. Relative commands resolve against the manifest's directory.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "id": {
          "description": "Unique among all agents.",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "command"
      ],
      "type": "object"
    },
    "BarId": {
      "description": "Which app bar a view container sits on.",
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "CommandContribution": {
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "ConfigurationContribution": {
      "properties": {
        "properties": {
          "additionalProperties": true,
          "description": "Setting key to its JSON Schema. `default` supplies the default value.",
          "type": "object"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "properties"
      ],
      "type": "object"
    },
    "Contributes": {
      "properties": {
        "agents": {
          "default": [],
          "description": "Agents for the agent pane.",
          "items": {
            "$ref": "#/definitions/AgentContribution"
          },
          "type": "array"
        },
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/definitions/CommandContribution"
          },
          "type": "array"
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/definitions/ConfigurationContribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "keybindings": {
          "default": [],
          "items": {
            "$ref": "#/definitions/KeybindingContribution"
          },
          "type": "array"
        },
        "menus": {
          "additionalProperties": {
            "items": {
              "$ref": "#/definitions/MenuContribution"
            },
            "type": "array"
          },
          "default": {},
          "description": "Menu location (e.g. `menubar/Tools`, `view/title`) to entries.",
          "type": "object"
        },
        "tools": {
          "default": [],
          "description": "Tools an agent can call, served by the plugin through `tool/call`.",
          "items": {
            "$ref": "#/definitions/ToolContribution"
          },
          "type": "array"
        },
        "viewContainers": {
          "default": [],
          "description": "Icon-strip entries on the app bars; views are placed in them by id.",
          "items": {
            "$ref": "#/definitions/ViewContainerContribution"
          },
          "type": "array"
        },
        "views": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ViewContribution"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Entry": {
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "KeybindingContribution": {
      "properties": {
        "command": {
          "type": "string"
        },
        "key": {
          "description": "Chord such as `Ctrl+Shift+P`. `Mod` is Cmd on macOS and Ctrl elsewhere.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "key"
      ],
      "type": "object"
    },
    "MenuContribution": {
      "properties": {
        "command": {
          "type": "string"
        },
        "group": {
          "description": "Entries sharing a group are kept together; groups are separated.",
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "ToolContribution": {
      "properties": {
        "description": {
          "description": "What the tool does, written for the agent that decides whether to call it.",
          "type": "string"
        },
        "inputSchema": {
          "description": "JSON Schema of the `arguments` object."
        },
        "name": {
          "description": "Unique among all tools: lowercase letters, digits and `_`, starting with a letter.",
          "type": "string"
        },
        "readOnly": {
          "default": false,
          "description": "The tool only reads. Tools that are not read-only are reported to agents as destructive.",
          "type": "boolean"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "inputSchema"
      ],
      "type": "object"
    },
    "ViewContainerContribution": {
      "properties": {
        "bar": {
          "allOf": [
            {
              "$ref": "#/definitions/BarId"
            }
          ],
          "default": "primary"
        },
        "icon": {
          "description": "Codicon name, e.g. `package`.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "order": {
          "default": 0,
          "description": "Lower sorts first within a bar.",
          "format": "int32",
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "icon"
      ],
      "type": "object"
    },
    "ViewContribution": {
      "properties": {
        "container": {
          "description": "Id of the view container to show the view in; the built-in\n`workbench.views` container when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/ViewKind"
            }
          ],
          "default": "tree"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "ViewKind": {
      "enum": [
        "tree",
        "list"
      ],
      "type": "string"
    }
  },
  "properties": {
    "activationEvents": {
      "default": [],
      "description": "When to start the process. Executing a contributed command or opening a\ncontributed view always activates the plugin; list `onStartup` to start eagerly.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "contributes": {
      "allOf": [
        {
          "$ref": "#/definitions/Contributes"
        }
      ],
      "default": {
        "agents": [],
        "commands": [],
        "keybindings": [],
        "menus": {},
        "tools": [],
        "viewContainers": [],
        "views": []
      }
    },
    "id": {
      "description": "Unique id, conventionally `publisher.name`.",
      "type": "string"
    },
    "main": {
      "anyOf": [
        {
          "$ref": "#/definitions/Entry"
        },
        {
          "type": "null"
        }
      ],
      "description": "How to start the sidecar. Relative paths resolve against the manifest's\ndirectory. Optional for plugins that only contribute agents or containers."
    },
    "name": {
      "type": "string"
    },
    "protocol": {
      "description": "Protocol version the plugin speaks, e.g. `\"0.1\"`.",
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "protocol"
  ],
  "title": "Manifest",
  "type": "object"
}
