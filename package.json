{
  "name": "openskele",
  "private": true,
  "workspaces": [
    "apps/workbench",
    "sdk/typescript",
    "plugins/*"
  ],
  "scripts": {
    "gen:protocol": "cargo run -q -p skele-protocol --bin gen-protocol && bun scripts/gen-sdk.ts",
    "gen:bindings": "cargo run -q -p tauri-plugin-skele --example export-bindings",
    "dev": "cd apps/workbench && bun tauri dev",
    "build": "cd apps/workbench && bun tauri build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "cargo test --workspace"
  }
}
